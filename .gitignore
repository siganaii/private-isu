vendor/
portal/log
portal/tmp

### Portal
# Ignore bundler config.
/portal/.bundle
/portal/vendor/bundle

# Ignore the default SQLite database.
/portal/db/*.sqlite3
/portal/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/portal/log/*
!/portal/log/.keep
/portal/tmp
.vagrant

# アプリが投稿画像を書き出すディレクトリ（nginx が直接配信する）
/webapp/public/image/
